<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_watilio" model="ir.ui.view">
        <field name="name">account.move.form.watilio</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_watilio_send" type="object" string="Send on WhatsApp"
                        icon="fa-whatsapp"
                        invisible="state != 'posted' or move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp" name="watilio_whatsapp" invisible="move_type != 'out_invoice'">
                    <group>
                        <group>
                            <field name="whatsapp_state"/>
                            <field name="whatsapp_phone"/>
                            <field name="whatsapp_sent_date"/>
                        </group>
                    </group>
                    <field name="whatsapp_error" nolabel="1" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_watilio" model="ir.ui.view">
        <field name="name">account.move.list.watilio</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="whatsapp_state" optional="show" widget="badge"
                       decoration-success="whatsapp_state == 'sent'"
                       decoration-danger="whatsapp_state == 'failed'"/>
            </xpath>
        </field>
    </record>
</odoo>
