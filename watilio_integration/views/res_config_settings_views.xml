<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_watilio" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.watilio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="WhatsApp Invoice (Watilio)" name="watilio_invoice_block">
                    <setting string="Send Invoices on WhatsApp"
                             help="Send the invoice PDF to the customer's phone when a customer invoice is posted.">
                        <field name="watilio_enabled"/>
                    </setting>
                    <setting string="Watilio Connection" invisible="not watilio_enabled"
                             help="API Secret and WhatsApp Account Unique ID from your Watilio dashboard.">
                        <div class="content-group">
                            <div class="row mt8"><label for="watilio_secret" class="col-lg-4 o_light_label"/><field name="watilio_secret" password="True"/></div>
                            <div class="row"><label for="watilio_account" class="col-lg-4 o_light_label"/><field name="watilio_account"/></div>
                            <div class="row"><label for="watilio_api_url" class="col-lg-4 o_light_label"/><field name="watilio_api_url"/></div>
                            <div class="row"><label for="watilio_extra_params" class="col-lg-4 o_light_label"/><field name="watilio_extra_params" placeholder='{"priority": 1}'/></div>
                        </div>
                    </setting>
                    <setting string="Message" invisible="not watilio_enabled"
                             help="Placeholders: {customer} {number} {amount} {date} {due_date} {company}">
                        <div class="content-group">
                            <div class="row mt8"><label for="watilio_country_code" class="col-lg-4 o_light_label"/><field name="watilio_country_code"/></div>
                            <div class="row"><label for="watilio_message_template" class="col-lg-4 o_light_label"/><field name="watilio_message_template"/></div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
